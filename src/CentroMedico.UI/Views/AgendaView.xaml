<UserControl x:Class="CentroMedico.UI.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1100"
             Background="White"
             Foreground="#183246"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary
            Source="/CentroMedico.UI;component/Resources/Estilos.xaml"/>
    </UserControl.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Agenda y cierre de consulta" FontSize="23" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Cargar citas" Command="{Binding ComandoCargar}"/>
                        <Button Content="Nuevo" Command="{Binding ComandoNuevo}"/>
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding disponible}">
                        <DataGrid ItemsSource="{Binding citas}" SelectedItem="{Binding citaSeleccionada, Mode=TwoWay}" Height="155">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="140"/>
                                <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente.Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Médico" Binding="{Binding Medico.Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="145"/>
                                <DataGridTextColumn Header="Tarifa S/" Binding="{Binding Tarifa, StringFormat=N2}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Historial clínico" FontSize="18" FontWeight="SemiBold"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Diagnóstico"/>
                                <TextBox Text="{Binding diagnostico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Observaciones (opcional)"/>
                                <TextBox Text="{Binding observaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Receta" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="Indicaciones generales"/>
                        <TextBox Text="{Binding indicaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Medicamento"/>
                                <TextBox Text="{Binding medicamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dosis"/>
                                <TextBox Text="{Binding dosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Frecuencia"/>
                                <TextBox Text="{Binding frecuencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Duración"/>
                                <TextBox Text="{Binding duracion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Agregar medicamento" Command="{Binding ComandoAgregarMedicamento}"/>
                            <Button Content="Quitar seleccionado" Command="{Binding ComandoQuitarMedicamento}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding medicamentos}" SelectedItem="{Binding medicamentoSeleccionado, Mode=TwoWay}" Height="125">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicamento" Binding="{Binding Medicamento}" Width="*"/>
                                <DataGridTextColumn Header="Dosis" Binding="{Binding Dosis}" Width="*"/>
                                <DataGridTextColumn Header="Frecuencia" Binding="{Binding Frecuencia}" Width="*"/>
                                <DataGridTextColumn Header="Duración" Binding="{Binding Duracion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Insumos utilizados" FontSize="18" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                            <ComboBox Width="310" Height="32" Margin="0,4,8,8"
                                      ItemsSource="{Binding insumos}" DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding insumoSeleccionado, Mode=TwoWay}"/>
                            <TextBlock Text="Cantidad:" VerticalAlignment="Center"/>
                            <TextBox Width="80" Text="{Binding cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding insumoSeleccionado.Stock, StringFormat='Stock: {0:N2}'}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding insumoSeleccionado.Unidad}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Agregar insumo" Command="{Binding ComandoAgregarInsumo}"/>
                            <Button Content="Quitar seleccionado" Command="{Binding ComandoQuitarInsumo}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding insumosUtilizados}" SelectedItem="{Binding consumoSeleccionado, Mode=TwoWay}" Height="125">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Insumo" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N2}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <Button Content="Cerrar consulta y generar orden de cobro"
                            Command="{Binding ComandoCerrarConsulta}" HorizontalAlignment="Left"
                            Style="{StaticResource BotonPrincipal}"/>
                    <TextBlock Text="{Binding mensaje}" TextWrapping="Wrap" Margin="0,12,0,15" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
</UserControl>