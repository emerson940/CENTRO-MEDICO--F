<UserControl x:Class="CentroMedico.UI.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="#183246"
             FontFamily="Segoe UI"
             FontSize="13">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="26">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,18">

                <TextBlock Text="Gestión de pacientes"
                           FontSize="27"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Registro y actualización de pacientes"
                           Foreground="#5F788A"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- Formulario -->
            <Border Grid.Row="1"
                    Background="#F7FBFD"
                    BorderBrush="#D6E7EF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Documento -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="Documento"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Documento,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 MaxLength="12"/>

                    </StackPanel>

                    <!-- Nombre -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="Nombre completo"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Nombre,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 MaxLength="100"/>

                    </StackPanel>

                    <!-- Fecha de nacimiento -->
                    <StackPanel Grid.Row="2"
                                Grid.Column="0">

                        <TextBlock Text="Fecha de nacimiento"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <DatePicker SelectedDate="{Binding FechaNacimiento,
                                                          Mode=TwoWay}"
                                    Height="42"
                                    VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Teléfono -->
                    <StackPanel Grid.Row="2"
                                Grid.Column="2">

                        <TextBlock Text="Teléfono (opcional)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Telefono,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 MaxLength="20"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- Botones -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,18,0,14">

                <Button Content="Nuevo"
                        Command="{Binding ComandoNuevo}"
                        MinWidth="120"
                        Height="46"
                        Margin="0,0,10,0"
                        Padding="18,8"/>

                <Button Content="Registrar paciente"
                        Command="{Binding ComandoRegistrar}"
                        MinWidth="155"
                        Height="46"
                        Margin="0,0,10,0"
                        Padding="18,8"
                        Background="#078CB5"
                        Foreground="White"
                        FontWeight="SemiBold"/>

                <Button Content="Actualizar paciente"
                        Command="{Binding ComandoActualizar}"
                        MinWidth="165"
                        Height="46"
                        Margin="0,0,10,0"
                        Padding="18,8"
                        Background="#EFC985"
                        Foreground="White"
                        FontWeight="SemiBold"/>

                <Button Content="Actualizar listado"
                        Command="{Binding ComandoCargar}"
                        MinWidth="150"
                        Height="46"
                        Padding="18,8"/>

            </StackPanel>

            <!-- Mensaje -->
            <Border Grid.Row="3"
                    Background="#EAF6FB"
                    BorderBrush="#D3E8F1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="13"
                    Margin="0,0,0,20">

                <TextBlock Text="{Binding Mensaje}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"/>

            </Border>

            <!-- Listado -->
            <StackPanel Grid.Row="4">

                <TextBlock Text="Pacientes registrados"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Seleccione un paciente para modificar sus datos."
                           Foreground="#5F788A"
                           Margin="0,0,0,10"/>

                <DataGrid ItemsSource="{Binding Pacientes}"
                          SelectedItem="{Binding PacienteSeleccionado,
                                                Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Height="260"
                          BorderBrush="#D6E7EF"
                          BorderThickness="1">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Documento"
                                            Binding="{Binding Documento}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Nombre completo"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Fecha de nacimiento"
                                            Binding="{Binding FechaNacimiento,
                                                              StringFormat={}{0:dd/MM/yyyy}}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding Telefono}"
                                            Width="160"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>