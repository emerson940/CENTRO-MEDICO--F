<UserControl x:Class="CentroMedico.UI.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000"
             Background="White"
             Foreground="#183246"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary
            Source="/CentroMedico.UI;component/Resources/Estilos.xaml"/>
    </UserControl.Resources>
    <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Historial clínico" FontSize="23" FontWeight="SemiBold"/>
                    <Button Content="Actualizar listado" Command="{Binding ComandoCargar}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding mensaje}" Margin="0,8" TextWrapping="Wrap"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding registros}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Cita" Binding="{Binding CitaId}" Width="60"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="145"/>
                        <DataGridTextColumn Header="Diagnóstico" Binding="{Binding Diagnostico}" Width="*"/>
                        <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
    </UserControl>
        
