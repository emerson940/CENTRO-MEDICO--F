<UserControl x:Class="CentroMedico.UI.Views.GestionCitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050"
             Background="White"
             Foreground="#183246"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/CentroMedico.UI;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- Encabezado -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Gestión de citas"
                               FontSize="23"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Registro, reprogramación y cancelación de citas médicas"
                               Foreground="#607D8B"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Actualizar listado"
                        Command="{Binding ComandoCargar}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Formulario -->
            <Border Background="#F7FBFD"
                    BorderBrush="#D7E5ED"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="18"
                    Margin="0,18,0,15">

                <Grid IsEnabled="{Binding disponible}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Código -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,5">

                        <TextBlock Text="Código de la cita"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding codigo}"
                                 IsReadOnly="True"
                                 Background="#EEF4F7"/>
                    </StackPanel>

                    <!-- Paciente -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,10,5">

                        <TextBlock Text="Paciente"
                                   FontWeight="SemiBold"/>

                        <ComboBox ItemsSource="{Binding pacientes}"
                                  SelectedItem="{Binding pacienteSeleccionado,
                                                        Mode=TwoWay}"
                                  DisplayMemberPath="Nombre"
                                  Margin="0,5,8,10"/>
                    </StackPanel>

                    <!-- Médico -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,5">

                        <TextBlock Text="Médico"
                                   FontWeight="SemiBold"/>

                        <ComboBox ItemsSource="{Binding medicos}"
                                  SelectedItem="{Binding medicoSeleccionado,
                                                        Mode=TwoWay}"
                                  DisplayMemberPath="Nombre"
                                  Margin="0,5,0,10"/>
                    </StackPanel>

                    <!-- Fecha -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Fecha"
                                   FontWeight="SemiBold"/>

                        <DatePicker SelectedDate="{Binding fecha,
                                                          Mode=TwoWay}"
                                    Height="36"
                                    Margin="0,5,8,10"/>
                    </StackPanel>

                    <!-- Hora -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Hora (HH:mm)"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding hora,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="5"/>
                    </StackPanel>

                    <!-- Tarifa -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="2">

                        <TextBlock Text="Tarifa S/"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding tarifa,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Botones -->
            <WrapPanel IsEnabled="{Binding disponible}"
                       Margin="0,0,0,8">

                <Button Content="Nueva cita"
                        Command="{Binding ComandoNuevo}"/>

                <Button Content="Registrar cita"
                        Command="{Binding ComandoRegistrar}"
                        Style="{StaticResource BotonPrincipal}"/>

                <Button Content="Reprogramar"
                        Command="{Binding ComandoReprogramar}"
                        Style="{StaticResource BotonPrincipal}"
                        Background="#D68715"
                        BorderBrush="#D68715"/>

                <Button Content="Cancelar cita"
                        Command="{Binding ComandoCancelar}"
                        Style="{StaticResource BotonPrincipal}"
                        Background="#C94A4A"
                        BorderBrush="#C94A4A"/>
            </WrapPanel>

            <!-- Mensaje -->
            <Border Background="#EEF7FB"
                    BorderBrush="#D7E5ED"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,5,0,10">

                <TextBlock Text="{Binding mensaje}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- Listado -->
            <TextBlock Text="Agenda registrada"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Seleccione una cita pendiente para reprogramarla o cancelarla."
                       Foreground="#607D8B"
                       Margin="0,3,0,0"/>

            <DataGrid ItemsSource="{Binding citas}"
                      SelectedItem="{Binding citaSeleccionada,
                                             Mode=TwoWay}"
                      IsEnabled="{Binding disponible}"
                      Height="300">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="50"/>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Codigo}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Documento"
                                        Binding="{Binding Paciente.Documento}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Paciente"
                                        Binding="{Binding Paciente.Nombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Médico"
                                        Binding="{Binding Medico.Nombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Fecha,
                                                  StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="145"/>

                    <DataGridTextColumn Header="Tarifa S/"
                                        Binding="{Binding Tarifa,
                                                  StringFormat=N2}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>