<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de sesión - Centro Médico"
        Width="920"
        Height="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EDF6FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary
            Source="/CentroMedico.UI;component/Resources/Estilos.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <!-- Imagen del centro médico -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <ImageBrush
                    ImageSource="/CentroMedico.UI;component/Assets/FondoConsulta.png"
                    Stretch="UniformToFill"/>
            </Grid.Background>

            <Border Background="#9A05678E"/>

            <StackPanel
                VerticalAlignment="Bottom"
                Margin="50">

                <Border Width="65"
                        Height="65"
                        Background="White"
                        CornerRadius="12"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18">

                    <TextBlock Text="✚"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#087FAA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Centro Médico"
                           FontSize="38"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Sistema de gestión de consultas"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Formulario del Login -->
        <Grid Grid.Column="1"
              Background="White">

            <Border Margin="45"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Bienvenido"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#183246"/>

                    <TextBlock
                        Text="Ingrese sus credenciales para continuar"
                        Foreground="#617584"
                        Margin="0,8,0,30"/>

                    <TextBlock Text="Usuario"
                               FontWeight="SemiBold"
                               Foreground="#183246"/>

                    <TextBox
                        Text="{Binding nombreUsuario,
                               Mode=TwoWay,
                               UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="40"
                        Height="42"/>

                    <TextBlock Text="Contraseña"
                               FontWeight="SemiBold"
                               Foreground="#183246"/>

                    <TextBox
                        Text="{Binding clave,
                               Mode=TwoWay,
                               UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="100"
                        Height="42"/>

                    <Button
                        Content="Iniciar sesión"
                        Command="{Binding ComandoIngresar}"
                        Style="{StaticResource BotonPrincipal}"
                        IsDefault="True"
                        Margin="0,15,0,0"/>

                    <TextBlock
                        Text="{Binding mensaje}"
                        Foreground="#C0392B"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Margin="0,18,0,0"/>

                    <TextBlock
                        Text="Acceso exclusivo para personal autorizado"
                        Foreground="#8193A0"
                        FontSize="11"
                        TextAlignment="Center"
                        Margin="0,30,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>