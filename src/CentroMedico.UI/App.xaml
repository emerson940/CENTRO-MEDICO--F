<Application x:Class="CentroMedico.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CentroMedico.UI.ViewModels"
             xmlns:views="clr-namespace:CentroMedico.UI.Views"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
               x:Key="BooleanoAVisibilidad"/>
            
            <DataTemplate DataType="{x:Type vm:GestionCitasViewModel}">
                <views:GestionCitasView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:PacientesViewModel}">
                <views:PacientesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MedicosViewModel}">
                <views:MedicosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CierreConsultaViewModel}">
                <views:AgendaView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HistorialViewModel}">
                <views:HistorialView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RecetasViewModel}">
                <views:RecetasView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FacturacionViewModel}">
                <views:FacturacionView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>